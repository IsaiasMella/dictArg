# Copiá este archivo como .env, pegá tus keys y listo.
# El .env no se sube al repo. También podés cargar las keys desde Ajustes.
# Dejá vacío lo que no uses: un valor vacío se ignora, pero cualquier texto
# se toma como key y tiene prioridad sobre la guardada en Ajustes.

# Transcripción (obligatoria): sin esta key no se puede dictar.
# Se crea en https://console.deepgram.com
DEEPGRAM_API_KEY=

# Formateo del texto (opcional): sin esta key se pega el texto tal cual sale
# de la transcripción. Se crea en https://console.groq.com/keys
GROQ_API_KEY=
